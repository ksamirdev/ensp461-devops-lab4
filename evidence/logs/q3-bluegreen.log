$ kubectl create namespace bluegreen --dry-run=client -o yaml | kubectl apply -f -
namespace/bluegreen created

$ kubectl apply -f deploy/bluegreen/blue.yaml -f deploy/bluegreen/services.yaml
deployment.apps/text-stats-blue created
service/text-stats created
service/text-stats-preview created

$ kubectl -n bluegreen rollout status deploy/text-stats-blue --timeout=180s
